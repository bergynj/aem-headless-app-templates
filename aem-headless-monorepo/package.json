{
  "name": "aem-headless-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "src/apps/*",
    "src/libs/*"
  ],
  "scripts": {
    "dev": "nx run content-site:dev & nx run content-mocks:serve & wait",
    "dev:site": "nx run content-site:dev",
    "dev:mocks": "nx run content-mocks:serve",
    "dev:ui": "nx run @aem-headless/ui:storybook",
    "start:site": "nx run content-site:start",
    "build": "nx run-many --target=build --all",
    "build:storybook": "nx run @aem-headless/ui:build-storybook",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint",
    "graph": "nx graph"
  },
  "dependencies": {
    "@adobe/aem-headless-client-js": "github:adobe/aem-headless-client-js",
    "@formatjs/intl-localematcher": "^0.4.0",
    "@vercel/analytics": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.1",
    "lucide-react": "^0.563.0",
    "morgan": "^1.10.0",
    "negotiator": "^0.6.3",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ruru": "^2.0.0-beta.11",
    "sharp": "^0.32.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nx/js": "22.4.4",
    "@nx/next": "^22.4.2",
    "@nx/node": "^22.4.2",
    "@nx/storybook": "^22.4.4",
    "@nx/vite": "22.4.4",
    "@nx/web": "22.4.4",
    "@nx/workspace": "^22.4.2",
    "@storybook/react-vite": "10.2.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/typography": "^0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/negotiator": "^0.6.4",
    "@types/node": "20.5.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "10.4.15",
    "eslint": "8.48.0",
    "eslint-config-next": "14.2.13",
    "nx": "^22.4.2",
    "postcss": "8.4.29",
    "prettier": "~3.6.2",
    "storybook": "10.2.3",
    "tailwindcss": "3.3.3",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "vite": "^6.0.0"
  }
}
