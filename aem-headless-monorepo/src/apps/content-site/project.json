{
  "name": "content-site",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src/apps/content-site/src",
  "projectType": "application",
  "tags": ["type:app", "scope:content-site"],
  "targets": {
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      }
    },
    "build": {
      "executor": "nx:run-script",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "script": "build"
      }
    },
    "start": {
      "executor": "nx:run-script",
      "options": {
        "script": "start"
      }
    },
    "lint": {
      "executor": "nx:run-script",
      "outputs": ["{options.outputFile}"],
      "options": {
        "script": "lint"
      }
    }
  }
}
