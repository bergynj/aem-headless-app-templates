{
  "name": "content-site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/content-site/src",
  "projectType": "application",
  "tags": ["type:app", "scope:content-site"],
  "targets": {
    "dev": {
      "executor": "@nx/next:dev",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "content-site:build",
        "dev": true,
        "port": 3000
      },
      "configurations": {
        "development": {
          "buildTarget": "content-site:build:development"
        },
        "production": {
          "buildTarget": "content-site:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/content-site"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "start": {
      "executor": "@nx/next:start",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "content-site:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "content-site:build:development"
        },
        "production": {
          "buildTarget": "content-site:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
