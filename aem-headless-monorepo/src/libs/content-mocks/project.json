{
  "name": "content-mocks",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src/libs/content-mocks/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:content-mocks"],
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "content-mocks:build",
        "watch": true
      },
      "configurations": {
        "production": {
          "buildTarget": "content-mocks:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/content-mocks",
        "main": "src/libs/content-mocks/src/server.ts",
        "tsConfig": "src/libs/content-mocks/tsconfig.json",
        "assets": ["src/libs/content-mocks/src/data/**/*"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
