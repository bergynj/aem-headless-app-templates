{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@aem-headless/ui": ["libs/ui/src/index.ts"],
      "@aem-headless/aem-ui": ["libs/aem-ui/src/index.ts"],
      "@aem-headless/aem-renderer": ["libs/aem-renderer/src/index.ts"],
      "@aem-headless/content-repo": ["libs/content-repo/src/index.ts"],
      "@aem-headless/content-model": ["libs/content-model/src/index.ts"]
    }
  },
  "include": []
}
